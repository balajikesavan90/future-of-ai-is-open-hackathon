{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balajikesavan90/arctic-analytics/schemas/analysis_trace.schema.json",
  "title": "Arctic Analytics Analysis Trace",
  "description": "Schema for the lightweight, non-replayable analysis trace snapshot exported by Arctic Analytics.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "trace_schema_version",
    "package_version",
    "timestamp",
    "session_id",
    "model",
    "cost",
    "context_window_usage",
    "system_message",
    "prompt_str",
    "messages",
    "events",
    "tool_calls",
    "outputs",
    "dataset_metadata",
    "errors",
    "limitations"
  ],
  "properties": {
    "trace_schema_version": {
      "type": "string",
      "enum": ["0.2.0", "0.3.0"]
    },
    "package_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "cost": {
      "type": ["number", "integer", "null"]
    },
    "context_window_usage": {
      "type": ["number", "integer", "null"]
    },
    "system_message": {
      "$ref": "#/$defs/json_safe"
    },
    "prompt_str": {
      "$ref": "#/$defs/json_safe"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/json_safe"
      }
    },
    "events": {
      "type": "array",
      "description": "Readable event timeline derived from the exported messages for consumers that need a compact trace overview.",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/json_safe"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/json_safe"
      }
    },
    "dataset_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "dataset_description",
          "column_names",
          "data_types",
          "primary_key",
          "data_dictionary"
        ],
        "properties": {
          "dataset_description": {
            "type": ["string", "null"]
          },
          "column_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_types": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "primary_key": {
            "$ref": "#/$defs/json_safe"
          },
          "data_dictionary": {
            "$ref": "#/$defs/json_safe"
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pandas_describe": {
            "$ref": "#/$defs/json_safe"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/json_safe"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resume": {
      "type": "object",
      "description": "Optional manifest used to continue an analysis with freshly uploaded CSV files.",
      "required": ["resume_schema_version", "source", "datasets"],
      "properties": {
        "resume_schema_version": {"const": "1.0"},
        "source": {"const": "uploader"},
        "researcher_notes": {"type": "string"},
        "resumed_from_session_id": {"type": ["string", "null"]},
        "messages": {
          "type": "array",
          "description": "Full-fidelity conversation state used only when resuming an analysis."
        },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dataset_key", "source_filename", "column_names"],
            "properties": {
              "dataset_key": {"type": "string"},
              "source_filename": {"type": "string"},
              "column_names": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "step_index",
        "event_type"
      ],
      "properties": {
        "step_index": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based position of the source message in the exported message list."
        },
        "event_type": {
          "type": "string",
          "description": "Readable event type derived from the source message type or role."
        },
        "role": {
          "type": "string",
          "description": "Message role when present, such as system, user, or assistant."
        },
        "tool_name": {
          "type": "string",
          "description": "Tool/function name for tool-call events when present."
        },
        "summary": {
          "type": "string",
          "description": "Short human-readable summary of the event when available."
        }
      }
    },
    "json_safe": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_safe"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json_safe"
          }
        }
      ]
    }
  }
}
